[Unit]
Description=Venus render server for Waydroid (Android Vulkan on the host GPU)
Before=waydroid-container.service

[Service]
User=waydroid-venus
Group=waydroid-venus
# /dev/udmabuf, to import the memfds Android allocates buffers from
SupplementaryGroups=kvm
Environment=LD_LIBRARY_PATH=@PREFIX@/lib
Environment=RENDER_SERVER_EXEC_PATH=@PREFIX@/libexec/virgl_render_server
Environment=__GL_SHADER_DISK_CACHE_PATH=/var/cache/waydroid-venus
CacheDirectory=waydroid-venus
# Waydroid shows its data directory to Android as /data.  Other services,
# such as a hardware decoder, keep sockets in the same directory, so it stays
# owned by the Waydroid user and the server gets access through an ACL.
# Changing the mode of the existing directory would reset the ACL mask and
# lock out the other services, so it is only created when missing.
ExecStartPre=+/bin/sh -c '[ -d "$1" ] || install -d -o "$2" -g "$2" -m 0755 "$1"' sh @SOCKET_DIR@ @USER@
ExecStartPre=+/usr/bin/setfacl -m u:waydroid-venus:rwx @SOCKET_DIR@
ExecStartPre=+/usr/bin/rm -f @SOCKET_DIR@/vtest.sock
ExecStart=@PREFIX@/bin/virgl_test_server --venus --no-virgl --socket-path @SOCKET_DIR@/vtest.sock
# Android apps run under their own uids and must be able to connect.
ExecStartPost=/bin/sh -c 'until [ -S "$1" ]; do sleep 0.1; done; chmod 0666 "$1"' sh @SOCKET_DIR@/vtest.sock
Restart=always
RestartSec=1

# Every Android app can send the server commands, so contain it: no home
# directories or user sessions apart from the socket directory, no network,
# read-only system, and only the GPU devices.
ProtectHome=tmpfs
BindPaths=@SOCKET_DIR@
InaccessiblePaths=-/run/dbus
ProtectSystem=strict
PrivateTmp=yes
PrivateNetwork=yes
DevicePolicy=closed
DeviceAllow=char-nvidia rw
DeviceAllow=char-nvidiactl rw
DeviceAllow=char-nvidia-modeset rw
DeviceAllow=char-nvidia-uvm rw
DeviceAllow=char-drm rw
DeviceAllow=/dev/udmabuf rw
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
TasksMax=1024
MemoryMax=8G

[Install]
WantedBy=multi-user.target
