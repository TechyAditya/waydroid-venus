+static VkResult
+vn_android_record_shadow_copy(struct vn_device *dev,
+                              struct vn_image *img,
+                              uint32_t queue_family)
+{
+   if (img->wsi.shadow_cmd && img->wsi.shadow_queue_family == queue_family)
+      return VK_SUCCESS;
+
+   VkDevice dev_handle = vn_device_to_handle(dev);
+   const struct vk_device_dispatch_table *disp = &dev->base.vk.dispatch_table;
+   VkResult result;
+
+   if (!img->wsi.shadow_fence) {
+      const VkFenceCreateInfo fence_info = {
+         .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO,
+      };
+      result = disp->CreateFence(dev_handle, &fence_info, NULL,
+                                 &img->wsi.shadow_fence);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   if (img->wsi.shadow_pool) {
+      disp->DestroyCommandPool(dev_handle, img->wsi.shadow_pool, NULL);
+      img->wsi.shadow_pool = VK_NULL_HANDLE;
+      img->wsi.shadow_cmd = VK_NULL_HANDLE;
+   }
+
+   const VkCommandPoolCreateInfo pool_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .queueFamilyIndex = queue_family,
+   };
+   VkCommandPool pool;
+   result = disp->CreateCommandPool(dev_handle, &pool_info, NULL, &pool);
+   if (result != VK_SUCCESS)
+      return result;
+
+   const VkCommandBufferAllocateInfo cmd_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = pool,
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+   };
+   VkCommandBuffer cmd;
+   result = disp->AllocateCommandBuffers(dev_handle, &cmd_info, &cmd);
+   if (result != VK_SUCCESS)
+      goto fail;
+
+   const VkCommandBufferBeginInfo begin_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+   };
+   result = disp->BeginCommandBuffer(cmd, &begin_info);
+   if (result != VK_SUCCESS)
+      goto fail;
+
+   const VkImageSubresourceRange range = {
+      .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+      .levelCount = 1,
+      .layerCount = 1,
+   };
+   const VkImageMemoryBarrier to_copy[2] = {
+      {
+         .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+         .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+         .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+         .oldLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+         .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+         .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+         .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+         .image = vn_image_to_handle(img),
+         .subresourceRange = range,
+      },
+      {
+         .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+         .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+         .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+         .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+         .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+         .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+         .image = vn_image_to_handle(img->wsi.anb_linear),
+         .subresourceRange = range,
+      },
+   };
+   disp->CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                            VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0,
+                            NULL, 2, to_copy);
+
+   const VkImageCopy region = {
+      .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+      .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+      .extent = img->base.vk.extent,
+   };
+   disp->CmdCopyImage(cmd, vn_image_to_handle(img),
+                      VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                      vn_image_to_handle(img->wsi.anb_linear),
+                      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+
+   /* concurrent images take no queue family ownership transfers */
+   const bool concurrent = img->wsi.anb_linear->base.vk.sharing_mode ==
+                           VK_SHARING_MODE_CONCURRENT;
+   const VkImageMemoryBarrier after_copy[2] = {
+      {
+         .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+         .srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+         .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+         .newLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+         .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+         .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+         .image = vn_image_to_handle(img),
+         .subresourceRange = range,
+      },
+      {
+         .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+         .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+         .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+         .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+         .srcQueueFamilyIndex = concurrent ? VK_QUEUE_FAMILY_IGNORED : queue_family,
+         .dstQueueFamilyIndex =
+            concurrent ? VK_QUEUE_FAMILY_IGNORED : VK_QUEUE_FAMILY_FOREIGN_EXT,
+         .image = vn_image_to_handle(img->wsi.anb_linear),
+         .subresourceRange = range,
+      },
+   };
+   disp->CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                            VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0, 0, NULL,
+                            0, NULL, 2, after_copy);
+
+   result = disp->EndCommandBuffer(cmd);
+   if (result != VK_SUCCESS)
+      goto fail;
+
+   /* only a completely recorded command buffer is ever cached */
+   img->wsi.shadow_pool = pool;
+   img->wsi.shadow_cmd = cmd;
+   img->wsi.shadow_queue_family = queue_family;
+   return VK_SUCCESS;
+
+fail:
+   disp->DestroyCommandPool(dev_handle, pool, NULL);
+   return result;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+vn_QueueSignalReleaseImageANDROID(VkQueue _queue,
+                                  uint32_t waitSemaphoreCount,
+                                  const VkSemaphore *pWaitSemaphores,
+                                  VkImage image,
+                                  int *pNativeFenceFd)
+{
+   struct vn_image *img = vn_image_from_handle(image);
+   if (!img->wsi.anb_linear) {
+      return vk_common_QueueSignalReleaseImageANDROID(
+         _queue, waitSemaphoreCount, pWaitSemaphores, image, pNativeFenceFd);
+   }
+
+   struct vn_queue *queue = vn_queue_from_handle(_queue);
+   struct vn_device *dev =
+      vn_device_from_handle(vk_device_to_handle(queue->base.vk.base.device));
+   VkDevice dev_handle = vn_device_to_handle(dev);
+   const struct vk_device_dispatch_table *disp = &dev->base.vk.dispatch_table;
+
+   VkResult result = vn_android_record_shadow_copy(
+      dev, img, queue->base.vk.queue_family_index);
+   if (result != VK_SUCCESS)
+      return vn_error(dev->instance, result);
+
+   STACK_ARRAY(VkPipelineStageFlags, wait_stages, waitSemaphoreCount);
+   for (uint32_t i = 0; i < waitSemaphoreCount; i++)
+      wait_stages[i] = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+   const VkSubmitInfo submit_info = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .waitSemaphoreCount = waitSemaphoreCount,
+      .pWaitSemaphores = pWaitSemaphores,
+      .pWaitDstStageMask = wait_stages,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &img->wsi.shadow_cmd,
+   };
+   result =
+      disp->QueueSubmit(_queue, 1, &submit_info, img->wsi.shadow_fence);
+   STACK_ARRAY_FINISH(wait_stages);
+   if (result != VK_SUCCESS)
+      return vn_error(dev->instance, result);
+
+   result = disp->WaitForFences(dev_handle, 1, &img->wsi.shadow_fence,
+                                VK_TRUE, UINT64_MAX);
+   if (result != VK_SUCCESS)
+      return vn_error(dev->instance, result);
+   disp->ResetFences(dev_handle, 1, &img->wsi.shadow_fence);
+
+   /* the copy has completed, so the native fence is already signaled */
+   *pNativeFenceFd = -1;
+   return VK_SUCCESS;
+}
