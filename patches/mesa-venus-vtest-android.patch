+VKAPI_ATTR VkResult VKAPI_CALL
+vn_GetAndroidHardwareBufferPropertiesANDROID(
+   VkDevice device,
+   const struct AHardwareBuffer *buffer,
+   VkAndroidHardwareBufferPropertiesANDROID *pProperties)
+{
+   VkResult result = vk_common_GetAndroidHardwareBufferPropertiesANDROID(
+      device, buffer, pProperties);
+   if (result != VK_SUCCESS)
+      return result;
+
+   /* Buffers in system memory, such as memfds that the renderer wraps in
+    * udmabufs, only import into system memory types.  ANGLE releases before
+    * 2024 require a device-local type for AHB imports, so also advertise the
+    * device-local types that are not host-visible.  The import falls back to
+    * a compatible type in vn_android_device_import_ahb.
+    */
+   const struct vn_device *dev = vn_device_from_handle(device);
+   const VkPhysicalDeviceMemoryProperties *mem_props =
+      &dev->physical_device->memory_properties;
+   uint32_t device_local_bits = 0;
+   for (uint32_t i = 0; i < mem_props->memoryTypeCount; i++) {
+      const VkMemoryPropertyFlags flags = mem_props->memoryTypes[i].propertyFlags;
+      if (!(flags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT))
+         continue;
+      if (pProperties->memoryTypeBits & (1u << i))
+         return VK_SUCCESS;
+      if (!(flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
+         device_local_bits |= 1u << i;
+   }
+   pProperties->memoryTypeBits |= device_local_bits;
+
+   return VK_SUCCESS;
+}
