+         .res_id = res_id,
+         .mmap_size = mappable ? size : 0,
+      },
+      .res_fd = res_fd,
+      .blob_flags = (mappable ? VCMD_BLOB_FLAG_MAPPABLE : 0) |
+                    VCMD_BLOB_FLAG_SHAREABLE,
+   };
