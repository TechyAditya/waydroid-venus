+static bool
+vn_android_anb_needs_shadow(const VkImageCreateInfo *create_info)
+{
+   struct u_gralloc *gralloc = vk_android_get_ugralloc();
+   return (create_info->usage & VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) &&
+          gralloc && u_gralloc_get_type(gralloc) == U_GRALLOC_TYPE_FALLBACK;
+}
