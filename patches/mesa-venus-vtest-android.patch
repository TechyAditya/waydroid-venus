+static VkResult
+vn_android_image_create_shadow(struct vn_device *dev,
+                               const VkImageCreateInfo *create_info,
+                               const VkAllocationCallbacks *alloc,
+                               struct vn_image *linear,
+                               struct vn_image **out_img)
+{
+   VkDevice dev_handle = vn_device_to_handle(dev);
+
+   VkImageCreateInfo info = *create_info;
+   info.tiling = VK_IMAGE_TILING_OPTIMAL;
+   info.usage |= VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+
+   struct vn_image *img;
+   VkResult result = vn_image_create(dev, &info, alloc, &img);
+   if (result != VK_SUCCESS)
+      return result;
+
+   const VkMemoryRequirements *req =
+      &img->requirements[0].memory.memoryRequirements;
+   const VkPhysicalDeviceMemoryProperties *mem_props =
+      &dev->physical_device->memory_properties;
+   uint32_t mem_type = ffs(req->memoryTypeBits) - 1;
+   for (uint32_t i = 0; i < mem_props->memoryTypeCount; i++) {
+      if ((req->memoryTypeBits & (1u << i)) &&
+          (mem_props->memoryTypes[i].propertyFlags &
+           VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) {
+         mem_type = i;
+         break;
+      }
+   }
+
+   const VkMemoryDedicatedAllocateInfo dedicated_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .image = vn_image_to_handle(img),
+   };
+   const VkMemoryAllocateInfo mem_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = &dedicated_info,
+      .allocationSize = req->size,
+      .memoryTypeIndex = mem_type,
+   };
+   VkDeviceMemory mem;
+   result = vn_AllocateMemory(dev_handle, &mem_info, alloc, &mem);
+   if (result != VK_SUCCESS) {
+      vn_DestroyImage(dev_handle, vn_image_to_handle(img), alloc);
+      return result;
+   }
+
+   const VkBindImageMemoryInfo bind_info = {
+      .sType = VK_STRUCTURE_TYPE_BIND_IMAGE_MEMORY_INFO,
+      .image = vn_image_to_handle(img),
+      .memory = mem,
+   };
+   result = vn_BindImageMemory2(dev_handle, 1, &bind_info);
+   if (result != VK_SUCCESS) {
+      vn_FreeMemory(dev_handle, mem, alloc);
+      vn_DestroyImage(dev_handle, vn_image_to_handle(img), alloc);
+      return result;
+   }
+
+   img->wsi.shadow_mem = vn_device_memory_from_handle(mem);
+   img->wsi.anb_linear = linear;
+   *out_img = img;
+
+   return VK_SUCCESS;
+}
