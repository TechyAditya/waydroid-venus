diff --git a/vtest/vtest_renderer.c b/vtest/vtest_renderer.c
index ba4feb1..1acd077 100644
--- a/vtest/vtest_renderer.c
+++ b/vtest/vtest_renderer.c
@@ -44,6 +44,11 @@
 #include <sys/uio.h>
 #include <sys/socket.h>
 #include <sys/mman.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <sys/vfs.h>
+#include <linux/magic.h>
+#include <linux/udmabuf.h>
 #ifdef HAVE_EVENTFD_H
 #include <sys/eventfd.h>
 #endif
@@ -3053,6 +3058,189 @@ out:
    return ret;
 }
 
+static int vtest_udmabuf_fd = -1;
+
+static int vtest_create_padding_memfd(uint64_t size)
+{
+   const int fd = memfd_create("vtest-padding", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+   if (fd < 0)
+      return -errno;
+
+   if (ftruncate(fd, size) || fcntl(fd, F_ADD_SEALS, F_SEAL_SHRINK)) {
+      const int ret = -errno;
+      close(fd);
+      return ret;
+   }
+
+   return fd;
+}
+
+/* Gralloc implementations without a GPU allocate buffers from memfd.  Host
+ * GPU drivers import dma-bufs rather than memfds, so wrap the memfd in a
+ * udmabuf.  The driver can require an allocation larger than the client
+ * buffer, and Android seals its memfds against growing, so padding pages
+ * from a second memfd are appended instead.
+ */
+static int vtest_memfd_to_dmabuf(int memfd, uint64_t size)
+{
+   const uint64_t page_size = getpagesize();
+
+   struct stat st;
+   if (fstat(memfd, &st))
+      return report_failure("fstat on memfd failed", -errno);
+
+   const uint64_t memfd_size = st.st_size;
+   if (!memfd_size || memfd_size % page_size)
+      return report_failure("memfd size is not page aligned", -EINVAL);
+
+   /* Drivers pad allocations by far less than this.  The limit keeps an
+    * untrusted client from making the server allocate padding memory.
+    */
+   const uint64_t max_padding = memfd_size / 4 + (2u << 20);
+   if (size > memfd_size && size - memfd_size > max_padding)
+      return report_failure("requested size exceeds the memfd size", -EINVAL);
+
+   const int seals = fcntl(memfd, F_GET_SEALS);
+   if (!(seals & F_SEAL_SHRINK) && fcntl(memfd, F_ADD_SEALS, F_SEAL_SHRINK))
+      return report_failure("failed to seal memfd", -errno);
+
+   if (vtest_udmabuf_fd < 0) {
+      vtest_udmabuf_fd = open("/dev/udmabuf", O_RDWR | O_CLOEXEC);
+      if (vtest_udmabuf_fd < 0)
+         return report_failure("failed to open /dev/udmabuf", -errno);
+   }
+
+   uint64_t list_storage[(sizeof(struct udmabuf_create_list) +
+                          2 * sizeof(struct udmabuf_create_item)) /
+                         sizeof(uint64_t) + 1] = { 0 };
+   struct udmabuf_create_list *list = (struct udmabuf_create_list *)list_storage;
+   list->flags = UDMABUF_FLAGS_CLOEXEC;
+   list->count = 1;
+   list->list[0] = (struct udmabuf_create_item){
+      .memfd = memfd,
+      .offset = 0,
+      .size = memfd_size,
+   };
+
+   int padding_fd = -1;
+   const uint64_t padding_size = align64(size, page_size) > memfd_size
+                                    ? align64(size, page_size) - memfd_size
+                                    : 0;
+   if (padding_size) {
+      padding_fd = vtest_create_padding_memfd(padding_size);
+      if (padding_fd < 0)
+         return report_failure("failed to create padding memfd", padding_fd);
+
+      list->list[1] = (struct udmabuf_create_item){
+         .memfd = padding_fd,
+         .offset = 0,
+         .size = padding_size,
+      };
+      list->count = 2;
+   }
+
+   /* the udmabuf keeps the pages of both memfds */
+   const int fd = ioctl(vtest_udmabuf_fd, UDMABUF_CREATE_LIST, list);
+   const int ret = fd < 0 ? -errno : 0;
+   if (padding_fd >= 0)
+      close(padding_fd);
+   if (fd < 0)
+      return report_failure("UDMABUF_CREATE_LIST failed", ret);
+
+   return fd;
+}
+
+static uint32_t vtest_import_fd(struct vtest_context *ctx, int fd, uint64_t size)
+{
+   /* F_GET_SEALS only succeeds on memfds */
+   if (fcntl(fd, F_GET_SEALS) >= 0) {
+      const int dmabuf_fd = vtest_memfd_to_dmabuf(fd, size);
+      close(fd);
+      if (dmabuf_fd < 0)
+         return 0;
+      fd = dmabuf_fd;
+   } else {
+      struct statfs fs;
+      if (fstatfs(fd, &fs) || fs.f_type != DMA_BUF_MAGIC) {
+         close(fd);
+         report_failure("imported fd is neither a memfd nor a dma-buf", -EINVAL);
+         return 0;
+      }
+   }
+
+   /* fstat rather than lseek: a received fd shares its offset with the
+    * client's fd
+    */
+   struct stat st;
+   if (fstat(fd, &st) || st.st_size <= 0 || size > (uint64_t)st.st_size) {
+      close(fd);
+      report_failure("invalid dma-buf size", -EINVAL);
+      return 0;
+   }
+   if (!size)
+      size = st.st_size;
+
+   struct vtest_resource *res = vtest_new_resource(0);
+   if (!res) {
+      close(fd);
+      return 0;
+   }
+
+   const struct virgl_renderer_resource_import_blob_args args = {
+      .res_handle = res->res_id,
+      .blob_mem = VIRGL_RENDERER_BLOB_MEM_HOST3D,
+      .fd_type = VIRGL_RENDERER_BLOB_FD_TYPE_DMABUF,
+      .fd = fd,
+      .size = size,
+   };
+   /* takes ownership of fd, even on failure */
+   const int ret = virgl_renderer_resource_import_blob(&args);
+   if (ret) {
+      vtest_unref_resource(res);
+      report_failed_call("virgl_renderer_resource_import_blob", ret);
+      return 0;
+   }
+
+   virgl_renderer_ctx_attach_resource(ctx->ctx_id, res->res_id);
+   util_hash_table_set(ctx->resource_table, intptr_to_pointer(res->res_id), res);
+
+   return res->res_id;
+}
+
+int vtest_resource_import_fd(uint32_t length_dw)
+{
+   struct vtest_context *ctx = vtest_get_current_context();
+   uint32_t vcmd_resource_import_fd[VCMD_RESOURCE_IMPORT_FD_SIZE];
+   uint32_t resp_buf[VTEST_HDR_SIZE + 1];
+   int ret;
+
+   if (ctx->protocol_version < 5)
+      return report_failed_call("protocol version too low", -EINVAL);
+   if (length_dw != VCMD_RESOURCE_IMPORT_FD_SIZE)
+      return report_failed_call("invalid command length", -EINVAL);
+
+   ret = ctx->input->read(ctx->input, &vcmd_resource_import_fd,
+                          sizeof(vcmd_resource_import_fd));
+   if (ret != sizeof(vcmd_resource_import_fd))
+      return -1;
+
+   const uint64_t size =
+      vcmd_resource_import_fd[VCMD_RESOURCE_IMPORT_FD_SIZE_LO] |
+      (uint64_t)vcmd_resource_import_fd[VCMD_RESOURCE_IMPORT_FD_SIZE_HI] << 32;
+
+   const int fd = vtest_receive_fd(ctx->input->data.fd);
+   if (fd < 0)
+      return fd;
+
+   /* a failed import replies with res_id 0 so that the client can recover */
+   resp_buf[VTEST_CMD_LEN] = 1;
+   resp_buf[VTEST_CMD_ID] = VCMD_RESOURCE_IMPORT_FD;
+   resp_buf[VTEST_CMD_DATA_START] = vtest_import_fd(ctx, fd, size);
+
+   ret = vtest_block_write(ctx->out_fd, resp_buf, sizeof(resp_buf));
+   return ret < 0 ? ret : 0;
+}
+
 void vtest_set_max_length(uint32_t length)
 {
    renderer.max_length = length;
